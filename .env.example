DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Translation model (default openai/gpt-oss-20b; llama-3.3-70b-versatile returned model_not_found on the test account)
# GROQ_MODEL=openai/gpt-oss-20b
# For Windows, path to onnxruntime.dll (e.g., C:\onnxruntime\bin\onnxruntime.dll)
ORT_DYLIB_PATH=C:\onnxruntime\bin\onnxruntime.dll
# Python used for local Whisper STT (default: pythonw.exe / python3 from PATH)
# TRANSLATOR_PYTHON=

# Audio Device Names (Change these to match your VB-Cable names in Windows)
TRANSLATOR_MIC_DEVICE=default
TRANSLATOR_SPEAKER_DEVICE=default
TRANSLATOR_MEET_INPUT=CABLE Output
TRANSLATOR_MEET_OUTPUT=CABLE Input

# Yandex Translate API (alternative to Groq, works from Russia)
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
